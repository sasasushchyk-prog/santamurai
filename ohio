local Players = game:GetService("Players")

local espEnabled = false
local highlights = {}

local function removeESP()
    for _, v in pairs(highlights) do
        if v then
            v:Destroy()
        end
    end

    highlights = {}
end

local function addESP(player)
    if player == Players.LocalPlayer then return end

    local function create(character)
        if not espEnabled then return end
        if not character then return end

        -- удаляем старый ESP
        if highlights[player] then
            highlights[player]:Destroy()
        end

        local highlight = Instance.new("Highlight")
        highlight.Name = "PlayerESP"
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Adornee = character
        highlight.Parent = game.CoreGui

        highlights[player] = highlight
    end

    if player.Character then
        create(player.Character)
    end

    player.CharacterAdded:Connect(function(character)
        task.wait(1)
        create(character)
    end)
end

esptab:Toggle("ESP", false, function(v)
    espEnabled = v

    removeESP()

    if espEnabled then
        for _, player in pairs(Players:GetPlayers()) do
            addESP(player)
        end
    end
end)

Players.PlayerAdded:Connect(function(player)
    if espEnabled then
        addESP(player)
    end
end)

Players.PlayerRemoving:Connect(function(player)
    if highlights[player] then
        highlights[player]:Destroy()
        highlights[player] = nil
    end
end)

local Players = game:GetService("Players")
local player = Players.LocalPlayer

local fakeHeadless = false

-- функция применения headless
local function applyHeadless(character)
    local head = character:FindFirstChild("Head")

    if head then
        -- скрываем голову
        head.Transparency = 1

        -- скрываем лицо
        local face = head:FindFirstChildOfClass("Decal")
        if face then
            face.Transparency = 1
        end

        -- скрываем аксессуары головы
        for _, v in pairs(character:GetChildren()) do
            if v:IsA("Accessory") then
                local handle = v:FindFirstChild("Handle")

                if handle and v.AccessoryType == Enum.AccessoryType.Hat then
                    handle.Transparency = 1
                end
            end
        end
    end
end

-- функция отключения
local function removeHeadless(character)
    local head = character:FindFirstChild("Head")

    if head then
        head.Transparency = 0

        local face = head:FindFirstChildOfClass("Decal")
        if face then
            face.Transparency = 0
        end

        for _, v in pairs(character:GetChildren()) do
            if v:IsA("Accessory") then
                local handle = v:FindFirstChild("Handle")

                if handle and v.AccessoryType == Enum.AccessoryType.Hat then
                    handle.Transparency = 0
                end
            end
        end
    end
end

-- после смерти снова применять
player.CharacterAdded:Connect(function(character)
    if fakeHeadless then
        character:WaitForChild("Head")

        task.wait(1)

        applyHeadless(character)
    end
end)

skintab:Toggle("Fake Headless", false, function(v)
    fakeHeadless = v

    local character = player.Character or player.CharacterAdded:Wait()

    if v then
        applyHeadless(character)
    else
        removeHeadless(character)
    end
end)









