local Players = game:GetService("Players")
local player = Players.LocalPlayer

local trailEnabled = false
local blackTrailEnabled = false


--// WHITE TRAIL

local function removeTrail()
    local character = player.Character
    if not character then return end

    for _, v in pairs(character:GetDescendants()) do
        if v.Name == "WhiteTrail"
        or v.Name == "TrailAttachment0"
        or v.Name == "TrailAttachment1" then
            v:Destroy()
        end
    end
end

local function createTrail()
    local character = player.Character or player.CharacterAdded:Wait()

    removeTrail()

    local root = character:WaitForChild("HumanoidRootPart")

    local attachment0 = Instance.new("Attachment")
    attachment0.Name = "TrailAttachment0"
    attachment0.Position = Vector3.new(0, -1.2, 0)
    attachment0.Parent = root

    local attachment1 = Instance.new("Attachment")
    attachment1.Name = "TrailAttachment1"
    attachment1.Position = Vector3.new(0, 1.2, 0)
    attachment1.Parent = root

    local trail = Instance.new("Trail")
    trail.Name = "WhiteTrail"

    trail.Attachment0 = attachment0
    trail.Attachment1 = attachment1

    trail.Color = ColorSequence.new(
        Color3.fromRGB(255, 255, 255)
    )

    trail.Lifetime = 2
    trail.MinLength = 0
    trail.LightEmission = 1
    trail.FaceCamera = true
    trail.Enabled = true

    trail.WidthScale = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.45),
        NumberSequenceKeypoint.new(1, 0)
    })

    trail.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.25),
        NumberSequenceKeypoint.new(1, 1)
    })

    trail.Parent = root
end


--// BLACK TRAIL

local function removeBlackTrail()
    local character = player.Character
    if not character then return end

    for _, v in pairs(character:GetDescendants()) do
        if v.Name == "BlackTrail"
        or v.Name == "BlackTrailAttachment0"
        or v.Name == "BlackTrailAttachment1" then
            v:Destroy()
        end
    end
end

local function createBlackTrail()
    local character = player.Character or player.CharacterAdded:Wait()

    removeBlackTrail()

    local root = character:WaitForChild("HumanoidRootPart")

    local attachment0 = Instance.new("Attachment")
    attachment0.Name = "BlackTrailAttachment0"
    attachment0.Position = Vector3.new(0, -1.2, 0)
    attachment0.Parent = root

    local attachment1 = Instance.new("Attachment")
    attachment1.Name = "BlackTrailAttachment1"
    attachment1.Position = Vector3.new(0, 1.2, 0)
    attachment1.Parent = root

    local trail = Instance.new("Trail")
    trail.Name = "BlackTrail"

    trail.Attachment0 = attachment0
    trail.Attachment1 = attachment1

    trail.Color = ColorSequence.new(
        Color3.fromRGB(0, 0, 0)
    )

    trail.Lifetime = 2
    trail.MinLength = 0
    trail.LightEmission = 0
    trail.FaceCamera = true
    trail.Enabled = true

    trail.WidthScale = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.45),
        NumberSequenceKeypoint.new(1, 0)
    })

    trail.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.25),
        NumberSequenceKeypoint.new(1, 1)
    })

    trail.Parent = root
end


