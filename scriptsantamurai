local korbloxEnabled = false

-- функция применения korblox
local function applyKorblox(character)
    local upper = character:FindFirstChild("RightUpperLeg")
    local lower = character:FindFirstChild("RightLowerLeg")
    local foot = character:FindFirstChild("RightFoot")

    -- удаляем части ноги
    if upper then
        upper:Destroy()
    end

    if lower then
        lower:Destroy()
    end

    -- уменьшаем стопу
    if foot then
        foot.Size = Vector3.new(1,0.5,1)

        local mesh = foot:FindFirstChildOfClass("SpecialMesh")
        if mesh then
            mesh.Scale = Vector3.new(0.5,0.5,0.5)
        end
    end
end

-- после смерти снова применять
player.CharacterAdded:Connect(function(character)
    if korbloxEnabled then
        character:WaitForChild("Humanoid")

        task.wait(1)

        applyKorblox(character)
    end
end)

