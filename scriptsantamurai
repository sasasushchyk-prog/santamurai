local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local jumpCirclesEnabled = false
local jumpConnection
local lastJumpState = false

local selectedCircleColor = "White"

local function createJumpCircle()
    local character = player.Character
    if not character then return end

    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = {character}

    local ray = workspace:Raycast(
        root.Position,
        Vector3.new(0, -10, 0),
        rayParams
    )

    if not ray then return end

    local circle = Instance.new("Part")
    circle.Name = "JumpCircle"
    circle.Shape = Enum.PartType.Cylinder

    -- Начинает с маленькой точки
    circle.Size = Vector3.new(0.08, 0.2, 0.2)

    circle.Anchored = true
    circle.CanCollide = false
    circle.CanTouch = false
    circle.CanQuery = false

    circle.Material = Enum.Material.Neon
    circle.Color = _G.color

    circle.CFrame =
        CFrame.new(ray.Position + Vector3.new(0, 0.04, 0))
        * CFrame.Angles(0, 0, math.rad(90))

    circle.Parent = workspace

    -- Расширяется как волна
    local expandTween = TweenService:Create(
        circle,
        TweenInfo.new(
            0.5,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out
        ),
        {
            Size = Vector3.new(0.08, 6, 6)
        }
    )

    expandTween:Play()

    -- Потом исчезает
    task.delay(0.25, function()
        if circle and circle.Parent then

            local fadeTween = TweenService:Create(
                circle,
                TweenInfo.new(0.5),
                {
                    Transparency = 1
                }
            )

            fadeTween:Play()

            fadeTween.Completed:Wait()

            if circle then
                circle:Destroy()
            end

        end
    end)
end


