local Players = game:GetService("Players")
local player = Players.LocalPlayer

local fakeHeadless = false

-- функция применения headless
local function applyHeadless(character)
    local head = character:FindFirstChild("Head")

    if head then
        -- скрываем голову
        head.Transparency = 1

        -- скрываем лицо
        local face = head:FindFirstChildOfClass("Decal")
        if face then
            face.Transparency = 1
        end

        -- скрываем аксессуары головы
        for _, v in pairs(character:GetChildren()) do
            if v:IsA("Accessory") then
                local handle = v:FindFirstChild("Handle")

                if handle and v.AccessoryType == Enum.AccessoryType.Hat then
                    handle.Transparency = 1
                end
            end
        end
    end
end

-- функция отключения
local function removeHeadless(character)
    local head = character:FindFirstChild("Head")

    if head then
        head.Transparency = 0

        local face = head:FindFirstChildOfClass("Decal")
        if face then
            face.Transparency = 0
        end

        for _, v in pairs(character:GetChildren()) do
            if v:IsA("Accessory") then
                local handle = v:FindFirstChild("Handle")

                if handle and v.AccessoryType == Enum.AccessoryType.Hat then
                    handle.Transparency = 0
                end
            end
        end
    end
end

-- после смерти снова применять
player.CharacterAdded:Connect(function(character)
    if fakeHeadless then
        character:WaitForChild("Head")

        task.wait(1)

        applyHeadless(character)
    end
end)

skintab:Toggle("Fake Headless", false, function(v)
    fakeHeadless = v

    local character = player.Character or player.CharacterAdded:Wait()

    if v then
        applyHeadless(character)
    else
        removeHeadless(character)
    end
end)









local Players = game:GetService("Players")
