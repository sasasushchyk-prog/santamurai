local function RemoveIcons()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character and plr.Character:FindFirstChild("Head") then
            local icon = plr.Character.Head:FindFirstChild("ScriptIcon")
            if icon then
                icon:Destroy()
            end
        end
    end
end

local function AddIcon(player)
    if not iconEnabled then return end
    if not Whitelist[player.Name] then return end

    local function Setup(character)
        local head = character:WaitForChild("Head")

        local old = head:FindFirstChild("ScriptIcon")
        if old then
            old:Destroy()
        end

        local gui = Instance.new("BillboardGui")
        gui.Name = "ScriptIcon"
        gui.Size = UDim2.new(0, 30, 0, 30)
        gui.StudsOffset = Vector3.new(0, 2.7, 0)
        gui.AlwaysOnTop = false -- не видно через стены
        gui.MaxDistance = 60 -- видно только вблизи
        gui.Parent = head

        local img = Instance.new("ImageLabel")
        img.BackgroundTransparency = 1
        img.Size = UDim2.fromScale(1,1)
        img.Image = "rbxassetid://99111619026666"
        img.Parent = gui
    end

    if player.Character then
        Setup(player.Character)
    end

    connections[player] = player.CharacterAdded:Connect(Setup)
end

