-- Сохраняет состояния функций между перезаходами в игру.
-- Требуется executor с поддержкой readfile/writefile/delfile.
local HttpService = game:GetService("HttpService")
local CFG_FILE = "SkyVisuals_LocalCFG.json"
local LocalCFG = {
    Enabled = false,
    States = {},
    Settings = {
        Time = 12,
        CrosshairSize = 3,
        MusicVolume = 1,
    }
}
_G.LocalCFGHandlers = {}

local function CFG_Load()
    if not (readfile and isfile) then return end
    local ok, exists = pcall(isfile, CFG_FILE)
    if not ok or not exists then return end

    local okRead, raw = pcall(readfile, CFG_FILE)
    if not okRead or not raw or raw == "" then return end

    local okDecode, data = pcall(function()
        return HttpService:JSONDecode(raw)
    end)
    if not okDecode or type(data) ~= "table" then return end

    LocalCFG = data
    LocalCFG.Enabled = true
    LocalCFG.States = LocalCFG.States or {}
    LocalCFG.Settings = LocalCFG.Settings or {}
end

local function CFG_Save()
    if not LocalCFG.Enabled or not writefile then return end
    pcall(function()
        writefile(CFG_FILE, HttpService:JSONEncode(LocalCFG))
    end)
end

local function CFG_Delete()
    if delfile and isfile then
        pcall(function()
            if isfile(CFG_FILE) then
                delfile(CFG_FILE)
            end
        end)
    end
    LocalCFG.Enabled = false
    LocalCFG.States = {}
end

