local RunService = game:GetService("RunService")

local lastStepPosition = nil
local stepConnection

local function createFootstep()
    local character = player.Character
    if not character then return end

    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = {character}

    local ray = workspace:Raycast(
        root.Position,
        Vector3.new(0, -6, 0),
        rayParams
    )

    if not ray then return end

    local step = Instance.new("Part")
    step.Name = "Footstep"
    step.Size = Vector3.new(0.8, 0.03, 1.2)
    step.Anchored = true
    step.CanCollide = false
    step.CanTouch = false
    step.CanQuery = false

    step.Material = Enum.Material.Neon
    step.Color = _G.color1

    step.CFrame = CFrame.new(
        ray.Position + Vector3.new(0, 0.03, 0)
    ) * CFrame.Angles(
        0,
        math.rad(root.Orientation.Y),
        0
    )

    step.Parent = workspace

    -- След исчезает через 3 секунды
    task.delay(3, function()
        if step then
            step:Destroy()
        end
    end)
end


