local function __cfg_HideGrass(enabled)
    LocalCFG.States["HideGrass"] = enabled
    CFG_Save()
    if enabled then
        hiddenGrass = {}

        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") then
                local c = v.Color

                if c.G > c.R and c.G > c.B and v.Size.Y <= 2 then
                    hiddenGrass[v] = {
                        Transparency = v.Transparency,
                        CanCollide = v.CanCollide
                    }

                    v.Transparency = 1
                    v.CanCollide = false
                end
            end
        end
    else
        for part, data in pairs(hiddenGrass) do
            if part and part.Parent then
                part.Transparency = data.Transparency
                part.CanCollide = data.CanCollide
            end
        end

        hiddenGrass = {}
    end
end
