            v.Color = colors[selectedColor]
        end

        if v.Name == "JumpCircle" then
            v.Color = colors[selectedColor]
        end
    end

end)













local jumpCirclesEnabled = false
local jumpConnection
local lastJumpState = false

local function createJumpCircle()
    local character = player.Character
    if not character then return end

    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = {character}

    local ray = workspace:Raycast(
        root.Position,
        Vector3.new(0, -10, 0),
        rayParams
    )

    if not ray then return end

    local circle = Instance.new("Part")
    circle.Name = "JumpCircle"
    circle.Shape = Enum.PartType.Cylinder
    circle.Size = Vector3.new(0.08, 3, 3)
    circle.Anchored = true
    circle.CanCollide = false
    circle.CanTouch = false
    circle.CanQuery = false

    circle.Material = Enum.Material.Neon
    circle.Color = colors[selectedColor]

    circle.CFrame =
        CFrame.new(ray.Position + Vector3.new(0, 0.04, 0))
        * CFrame.Angles(0, 0, math.rad(90))

    circle.Parent = workspace

    -- Круг исчезает через 3 секунды
    task.delay(3, function()
        if circle then
            circle:Destroy()
        end
    end)
end


visualtab:Toggle("Jump Circles", false, function(value)

    jumpCirclesEnabled = value

    if value then

        jumpConnection = game:GetService("RunService").Heartbeat:Connect(function()

            local character = player.Character
            if not character then return end

            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if not humanoid then return end

            local state = humanoid:GetState()

            -- Игрок был в воздухе и приземлился
            if lastJumpState
            and (
                state == Enum.HumanoidStateType.Landed
                or state == Enum.HumanoidStateType.Running
            ) then

                createJumpCircle()

            end

            if state == Enum.HumanoidStateType.Freefall
            or state == Enum.HumanoidStateType.Jumping then

                lastJumpState = true

            else

                lastJumpState = false

            end

        end)

    else

        if jumpConnection then
            jumpConnection:Disconnect()
            jumpConnection = nil
        end

        -- Удаляем уже созданные круги
        for _, v in pairs(workspace:GetChildren()) do
            if v.Name == "JumpCircle" then
                v:Destroy()
            end
        end

    end

end)






