local Players = game:GetService("Players")

local espEnabled = false
local espObjects = {}

local function addESP(plr, char)
    if plr == Players.LocalPlayer or not char then return end

    local head = char:FindFirstChild("Head")
    if not head then return end

    if espObjects[plr] then
        espObjects[plr]:Destroy()
    end

    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0, 120, 0, 25)
    bb.StudsOffset = Vector3.new(0, 2, 0)
    bb.AlwaysOnTop = true
    bb.Parent = head

    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.new(0.4, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.Text = plr.DisplayName
    txt.TextScaled = true
    txt.Font = Enum.Font.GothamBold

    -- 🔴 КРАСНЫЙ СТИЛЬ
    txt.TextColor3 = Color3.fromRGB(255, 60, 60)
    txt.TextStrokeTransparency = 0
    txt.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)

    txt.Parent = bb

    espObjects[plr] = bb
end

local function hook(plr)
    plr.CharacterAdded:Connect(function(c)
        task.wait(0.5)
        if espEnabled then
            addESP(plr, c)
        end
    end)

    if plr.Character and espEnabled then
        addESP(plr, plr.Character)
    end
end

visualtab:Toggle("ESP Names", false, function(v)
    espEnabled = v

    if not v then
        for _, g in pairs(espObjects) do
            g:Destroy()
        end
        espObjects = {}
    else
        for _, p in pairs(Players:GetPlayers()) do
            hook(p)
        end
    end
end)

Players.PlayerAdded:Connect(hook)

Players.PlayerRemoving:Connect(function(p)
    if espObjects[p] then
        espObjects[p]:Destroy()
        espObjects[p] = nil
    end
end)











local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local enabled = false
local holding = false
local maxDistance = 200

local function getClosestPlayer()
    local closest = nil
    local dist = math.huge

    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            local head = plr.Character:FindFirstChild("Head")

            if head then
                local mag = (camera.CFrame.Position - head.Position).Magnitude

                if mag < dist and mag <= maxDistance then
                    dist = mag
                    closest = head
                end
            end
        end
    end

    return closest
end

-- TOGGLE
combattab:Toggle("Aimbot", false, function(v)
    enabled = v
end)

-- SLIDER ДО 1000
combattab:Slider("Aimbot Distance", 0, 500, 250, function(v)
    maxDistance = v
end)

-- RMB hold
UIS.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        holding = true
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        holding = false
    end
end)

-- AIM LOOP
RunService.RenderStepped:Connect(function()
    if not enabled then return end
    if not holding then return end

    local target = getClosestPlayer()
    if target then
        camera.CFrame = camera.CFrame:Lerp(
            CFrame.new(camera.CFrame.Position, target.Position),
            0.2
        )
    end
end)













