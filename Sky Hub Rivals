local Players = game:GetService("Players")

local espEnabled = false
local highlights = {}

local function removeESP()
    for _, v in pairs(highlights) do
        if v then
            v:Destroy()
        end
    end

    highlights = {}
end

local function addESP(player)
    if player == Players.LocalPlayer then return end

    local function create(character)
        if not espEnabled then return end
        if not character then return end

        -- удаляем старый ESP
        if highlights[player] then
            highlights[player]:Destroy()
        end

        local highlight = Instance.new("Highlight")
        highlight.Name = "PlayerESP"
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Adornee = character
        highlight.Parent = game.CoreGui

        highlights[player] = highlight
    end

    if player.Character then
        create(player.Character)
    end

    player.CharacterAdded:Connect(function(character)
        task.wait(1)
        create(character)
    end)
end

esptab:Toggle("ESP", false, function(v)
    espEnabled = v

    removeESP()

    if espEnabled then
        for _, player in pairs(Players:GetPlayers()) do
            addESP(player)
        end
    end
end)

Players.PlayerAdded:Connect(function(player)
    if espEnabled then
        addESP(player)
    end
end)

Players.PlayerRemoving:Connect(function(player)
    if highlights[player] then
        highlights[player]:Destroy()
        highlights[player] = nil
    end
end)






local Players = game:GetService("Players")

local espEnabled = false
local espObjects = {}

local function addESP(plr, char)
    if plr == Players.LocalPlayer or not char then return end

    local head = char:FindFirstChild("Head")
    if not head then return end

    if espObjects[plr] then
        espObjects[plr]:Destroy()
    end

    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0, 120, 0, 25)
    bb.StudsOffset = Vector3.new(0, 2, 0)
    bb.AlwaysOnTop = true
    bb.Parent = head

    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.new(0.4, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.Text = plr.DisplayName
    txt.TextScaled = true
    txt.Font = Enum.Font.GothamBold

    -- 🔴 КРАСНЫЙ СТИЛЬ
    txt.TextColor3 = Color3.fromRGB(255, 60, 60)
    txt.TextStrokeTransparency = 0
    txt.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)

    txt.Parent = bb

    espObjects[plr] = bb
end

local function hook(plr)
    plr.CharacterAdded:Connect(function(c)
        task.wait(0.5)
        if espEnabled then
            addESP(plr, c)
        end
    end)

    if plr.Character and espEnabled then
        addESP(plr, plr.Character)
    end
end

esptab:Toggle("ESP Names", false, function(v)
    espEnabled = v

    if not v then
        for _, g in pairs(espObjects) do
            g:Destroy()
        end
        espObjects = {}
    else
        for _, p in pairs(Players:GetPlayers()) do
            hook(p)
        end
    end
end)

Players.PlayerAdded:Connect(hook)

Players.PlayerRemoving:Connect(function(p)
    if espObjects[p] then
        espObjects[p]:Destroy()
        espObjects[p] = nil
    end
end)








